/* NOTE:                                                                   */
/* This raster image is composed of a set of pixels that represent finite  */
/* areas, and not discrete points.  The center of the upper left pixel is  */
/* defined as line and sample (1.0,1.0). The                               */
/* [LINE,SAMPLE]_PROJECTION_OFFSET elements are the pixel offset from line */
/* and sample (1.0,1.0) to the map projection origin (defined by the       */
/* CENTER_LATITUDE and CENTER_LONGITUDE elements).  These offset values    */
/* are positive when the map projection origin is to the right or below    */
/* the center of the upper left pixel. This definition was adopted in      */
/* November 2011 by the LROC team.                                         */

OBJECT = IMAGE_MAP_PROJECTION
    ^DATA_SET_MAP_PROJECTION     = "DSMAP.CAT"
    MAP_PROJECTION_TYPE          = EQUIRECTANGULAR
    PROJECTION_LATITUDE_TYPE     = PLANETOCENTRIC
    A_AXIS_RADIUS                = 1737.4 <KM>
    B_AXIS_RADIUS                = 1737.4 <KM>
    C_AXIS_RADIUS                = 1737.4 <KM>
    COORDINATE_SYSTEM_NAME       = PLANETOCENTRIC
    POSITIVE_LONGITUDE_DIRECTION = EAST
    KEYWORD_LATITUDE_TYPE        = PLANETOCENTRIC
    /* NOTE:  CENTER_LATITUDE and CENTER_LONGITUDE describe the location   */
    /* of the center of projection, which is not necessarily equal to the  */
    /* location of the center point of the image.                          */
    CENTER_LATITUDE              = 26.0 <DEG>
    CENTER_LONGITUDE             = 180.0 <DEG>
    LINE_FIRST_PIXEL             = 1
    LINE_LAST_PIXEL              = 10673
    SAMPLE_FIRST_PIXEL           = 1
    SAMPLE_LAST_PIXEL            = 2984
    MAP_PROJECTION_ROTATION      = 0.0 <DEG>
    MAP_RESOLUTION               = 6064.67008483 <PIX/DEG>
    MAP_SCALE                    = 4.9999999999999005 <METERS/PIXEL>
    MAXIMUM_LATITUDE             = 26.87079391 <DEG>
    MINIMUM_LATITUDE             = 25.1110939 <DEG>
    EASTERNMOST_LONGITUDE        = 3.84027177 <DEG>
    WESTERNMOST_LONGITUDE        = 3.29288009 <DEG>
    LINE_PROJECTION_OFFSET       = 162962.5 <PIXEL>
    SAMPLE_PROJECTION_OFFSET     = 963210.5 <PIXEL>
END_OBJECT = IMAGE_MAP_PROJECTION

OBJECT = IMAGE
    DESCRIPTION                = "Apollo 15 Landing Site and Surrounding
                                 Terrain digital terrain model confidence map.
                                 For more info, see [HENRIKSENETAL2017]."
    LINES                      = 10673
    LINE_SAMPLES               = 2984
    SAMPLE_TYPE                = MSB_UNSIGNED_INTEGER
    SAMPLE_BITS                = 8
    SAMPLE_BIT_MASK            = 2#11111111#
    SCALING_FACTOR             = 1.0
    OFFSET                     = 0.0
    CORE_NULL                  = 0
    CORE_LOW_REPR_SATURATION   = 0
    CORE_LOW_INSTR_SATURATION  = 0
    CORE_HIGH_REPR_SATURATION  = 255
    CORE_HIGH_INSTR_SATURATION = 255
    BAND_STORAGE_TYPE          = BAND_SEQUENTIAL
    BANDS                      = 1
    FILTER_NAME                = "N/A"
END_OBJECT = IMAGE

END
